# Local dev (docker compose up): matches docker-compose.yml credentials.
# In production (Neon): DATABASE_URL is the pooled connection string (-pooler host),
# DIRECT_URL is the unpooled one Prisma uses for migrations. See docs/decisions.md
# for why both are needed on serverless.
DATABASE_URL="postgresql://statuspulse:statuspulse@localhost:5432/statuspulse"
DIRECT_URL="postgresql://statuspulse:statuspulse@localhost:5432/statuspulse"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Bearer token the cron service must present to /api/cron/run-checks.
# Never commit a real value.
CRON_SECRET="replace-with-a-random-secret"

# Resend (incident-open/resolve email notifications). Optional — without
# it, sendEmail logs and no-ops instead of throwing, so the check runner
# works locally/on a demo deploy without a real Resend account.
RESEND_API_KEY=""
# Sender for alert emails; must be on a domain verified in Resend.
# Defaults to Resend's test sender (onboarding@resend.dev) when empty.
EMAIL_FROM=""

# Monitors pointing at localhost/private IPs are blocked to prevent SSRF.
# Set to "true" only in local dev if you want to monitor a local service.
ALLOW_PRIVATE_TARGETS="false"
