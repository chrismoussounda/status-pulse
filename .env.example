# Local dev (docker compose up): matches docker-compose.yml credentials.
# In production (Neon): DATABASE_URL is the pooled connection string (-pooler host),
# DIRECT_URL is the unpooled one Prisma uses for migrations. See the Engineering
# Decisions section in the README for why both are needed on serverless.
DATABASE_URL="postgresql://statuspulse:statuspulse@localhost:5432/statuspulse"
DIRECT_URL="postgresql://statuspulse:statuspulse@localhost:5432/statuspulse"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Bearer token the GitHub Actions cron workflow must present to /api/cron/run-checks.
# Set as a GitHub repo secret in production — never commit a real value.
CRON_SECRET="replace-with-a-random-secret"

# Resend (email notifications) — added in Epic 3.
RESEND_API_KEY=""
